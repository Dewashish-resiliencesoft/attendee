# Webpage streamer resolution and frame rate.
#
# Precedence: CLI flags, then these env vars, then the per-platform default.
#
# Platform defaults (when the vars below are unset):
#   Google Meet          1920x1080 @ 30fps   (Meet's screen-share ceiling)
#   Zoom                 1920x1080 @ 60fps
#   Microsoft Teams      1920x1080 @ 60fps
#   local / test         1920x1080 @ 60fps
#
# Google Meet still limits screen share to about 30 fps for viewers, even if the
# streamer captures faster.
#
# Copy into .env to force 1920x1080 @ 60fps for every platform, including Meet.
# For local Docker, also use dev.docker-compose.1080p60.yaml so the streamer
# container gets 4 CPUs and 8g of memory:
#   docker compose -f dev.docker-compose.yaml -f dev.docker-compose.1080p60.yaml --profile webpage-streamer up

WEBPAGE_STREAMER_VIDEO_FRAME_SIZE=1920x1080
WEBPAGE_STREAMER_VIDEO_FPS=60

# Kubernetes webpage-streamer pod. The CPU request defaults to 1 and there is
# no CPU limit unless WEBPAGE_STREAMING_CPU_LIMIT is set. 1080p30/60 needs more
# than one core. Memory limit defaults to 4Gi.
WEBPAGE_STREAMING_CPU_REQUEST=4
WEBPAGE_STREAMING_CPU_LIMIT=4
WEBPAGE_STREAMING_MEMORY_REQUEST=8Gi
WEBPAGE_STREAMING_MEMORY_LIMIT=8Gi
